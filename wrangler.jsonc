{
  // Billy is a static export: `bun run build` writes apps/web/out, and this
  // Worker only serves those files. There is no `main`, so no Worker code
  // runs — Cloudflare serves the assets directly.
  //
  // html_handling "auto-trailing-slash" is what makes /editor resolve. Next
  // exports that route as editor.html, not editor/index.html, so without it
  // the editor link 404s. out/_headers still applies: Workers parses it the
  // same way Pages did.
  "name": "billy",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./apps/web/out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
