{
  "extends": "@billy/typescript-config/base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@billy/invoice-core": ["../../packages/invoice-core/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // migrate-images-to-storage.ts is a dead Supabase leftover (see AGENTS.md):
  // it imports a package the workspace no longer depends on, which fails the
  // app build on a clean install. download-fonts.ts stays type-checked.
  "exclude": ["node_modules", "scripts/migrate-images-to-storage.ts"]
}
